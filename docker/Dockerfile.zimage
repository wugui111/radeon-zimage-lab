FROM crpi-xhg6joi134vrkpzq.cn-shanghai.personal.cr.aliyuncs.com/vivienfanghua/amd-oneclick-base:rocm7.2.1-py3.12-v20260416

ENV MODEL_CACHE_DIR=/opt/models
ENV HF_HOME=/opt/hf_home
ENV MODELSCOPE_CACHE=/opt/models

WORKDIR /workspace/zimage

COPY scripts/ ./scripts/

RUN python -c "import torch; print('PyTorch:', torch.__version__); print('CUDA/ROCm interface available:', torch.cuda.is_available()); raise SystemExit(0 if torch.cuda.is_available() else 'ROCm PyTorch is not available in the base image.')"

RUN TORCH_VERSION="$(python -c 'import torch; print(torch.__version__)')" && \
    printf 'torch==%s\n' "${TORCH_VERSION}" > /tmp/torch-constraint.txt && \
    python -m pip install -U pip && \
    python -m pip install -U --upgrade-strategy only-if-needed -c /tmp/torch-constraint.txt modelscope accelerate "transformers>=4.56,<5" sentencepiece safetensors pillow && \
    python -m pip install -U --upgrade-strategy only-if-needed -c /tmp/torch-constraint.txt "diffusers==0.36.0"

RUN python scripts/05_warmup_model_cache.py

CMD ["bash", "-lc", "jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --allow-root"]
